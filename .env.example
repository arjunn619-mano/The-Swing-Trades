# Copy to .env and fill in. NEVER commit the real .env (it is git-ignored).
# For production these live in GitHub Actions Secrets (worker) and Vercel env vars (web) — not in any file.

# === Dhan (worker only — these can place trades; keep private) ===
DHAN_CLIENT_ID=
DHAN_PIN=
DHAN_TOTP_SECRET=

# === Neon Postgres ===
# Worker writes via the direct (unpooled) connection:
DATABASE_URL=
# Web reads via the POOLED connection (set this one in Vercel env):
DATABASE_URL_POOLED=

# === Failure alerts (worker watchdog) — Telegram by default ===
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# === Dashboard owner PIN (web only) — set this in Vercel env ===
# Gates the ONLY public write action (editing watchlist stars). Anyone can view/sort/filter the
# dashboard, but only someone who enters this PIN can save/remove a star; everyone else's clicks
# are rejected and never stored. If unset, star-writing is disabled entirely (fails closed).
# Pick a non-trivial value (not 1234). You enter it once in the dashboard; it's kept in that browser.
OWNER_PIN=
